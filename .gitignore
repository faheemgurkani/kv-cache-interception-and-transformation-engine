# ── Secrets & local environment ──────────────────────────────────────────────
.venv/
.env
.env.local
.env.*.local
!.env.example

# HuggingFace / PyTorch / dataset caches (downloaded at runtime)
.cache/
.huggingface/

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── Model weights (download via scripts; never commit) ─────────────────────────
models/*/
!models/.gitkeep
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# ── Datasets (WikiText-2 / C4 fetched via HuggingFace datasets) ────────────────
datasets/wikitext2/*
datasets/c4/*
!datasets/wikitext2/.gitkeep
!datasets/c4/.gitkeep
data/**

# ── Experiment outputs ─────────────────────────────────────────────────────────
# Ignore bulky raw dumps by default; keep published summary bundles + README.
results/*
!results/.gitkeep
!results/README.md
!results/phase5_modal_baseline/
!results/phase5_modal_baseline/**
!results/phase5_modal_qjl/
!results/phase5_modal_qjl/**
!results/phase5_modal_rocketkv/
!results/phase5_modal_rocketkv/**
!results/phase5_modal_sweep_128_256_512/
!results/phase5_modal_sweep_128_256_512/**
!results/olmo2_phase5_baseline/
!results/olmo2_phase5_baseline/**
!results/olmo2_phase5_turboquant/
!results/olmo2_phase5_turboquant/**
!results/phase5_modal_qjl_prodqjl/
!results/phase5_modal_qjl_prodqjl/**
!results/olmo2_phase5_qjl_prodqjl/
!results/olmo2_phase5_qjl_prodqjl/**
!results/olmo2_phase5_rocketkv/
!results/olmo2_phase5_rocketkv/**
!results/olmo2_phase5_summary.json
!results/olmo2_phase5_inventory.csv
# Drop per-job copies and raw Modal volume mirrors even inside allowed trees
results/**/jobs/
results/modal_volume/
results/modal_volume_olmo2/
plots/*
!plots/.gitkeep
wandb/
*.log
logs/

# ── Local planning / unpublished draft paper ───────────────────────────────────
docs/IMPLEMENTATION_PLAN.md
docs/EVALUATION_PLAN.md
docs/CURRENT_STATE.md
docs/research_paper_writeup/

# ── IDE & OS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

